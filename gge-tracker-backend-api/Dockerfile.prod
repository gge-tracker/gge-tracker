FROM node:24-slim AS build

ENV PUPPETEER_SKIP_DOWNLOAD=1

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

COPY tsconfig.json ./
COPY src ./src

RUN npm run build

FROM node:24-slim AS deps

ENV PUPPETEER_SKIP_DOWNLOAD=1 \
    PUPPETEER_CACHE_DIR=/opt/puppeteer

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && node_modules/.bin/puppeteer browsers install chrome \
    && npm cache clean --force \
    && rm -rf /root/.npm /tmp/*

FROM node:24-slim AS production

ENV NODE_ENV=production \
    PUPPETEER_CACHE_DIR=/opt/puppeteer \
    REDIS_URL=redis://redis-server:6379

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    fonts-freefont-ttf \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libexpat1 \
    libgbm1 \
    libglib2.0-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libx11-6 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=deps /opt/puppeteer /opt/puppeteer
COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist/api/ ./dist/
COPY --from=build --chown=node:node /app/dist/documentation.json ./dist/documentation.json
COPY --from=build --chown=node:node /app/src/api/lib ./dist/lib
COPY --chown=node:node package.json ./

RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
    && dpkg --purge --force-remove-essential --force-depends perl-base \
    && mkdir -p /app/dist/assets && chown -R node:node /app/dist

USER node

EXPOSE 3000

CMD ["node", "dist/main.js"]
