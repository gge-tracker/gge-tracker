{
  "name": "gge-tracker-backend-api",
  "version": "26.08.23-beta",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "description": "",
  "scripts": {
    "start": "node dist/api/main.js",
    "documentation": "node ./dist/documentation.js",
    "build": "npx tsc && node ./dist/documentation.js",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "dev": "nodemon",
    "test:api": "ts-node --project tests/tsconfig.json tests/run.ts",
    "test:api:semantic": "ts-node --project tests/tsconfig.json tests/run.ts semantic",
    "test:api:oracle": "ts-node --project tests/tsconfig.json tests/run.ts oracle",
    "test:api:snapshot": "ts-node --project tests/tsconfig.json tests/run.ts snapshot",
    "test:api:snapshot:update": "TEST_SNAPSHOT_UPDATE=1 ts-node --project tests/tsconfig.json tests/run.ts snapshot",
    "test:api:strict": "TEST_REQUIRE_SEEDS=1 ts-node --project tests/tsconfig.json tests/run.ts all",
    "test:api:static": "ts-node --project tests/tsconfig.json tests/run.ts openapi coverage",
    "test:api:openapi": "ts-node --project tests/tsconfig.json tests/run.ts openapi",
    "test:api:coverage": "ts-node --project tests/tsconfig.json tests/run.ts coverage",
    "test:api:reset-offset": "ts-node --project tests/tsconfig.json tests/run.ts reset-offset",
    "test:api:security": "ts-node --project tests/tsconfig.json tests/run.ts security",
    "test:api:load": "ts-node --project tests/tsconfig.json tests/run.ts timing load",
    "test:api:full": "ts-node --project tests/tsconfig.json tests/run.ts all",
    "fixtures:dump": "../database/fixtures/dump-fixtures.sh",
    "fixtures:load": "../database/fixtures/load-fixtures.sh",
    "fixtures:capture-empire-api": "../database/fixtures/capture-empire-api.sh"
  },
  "dependencies": {
    "@clickhouse/client": "^1.13.0",
    "axios": "^1.16.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.5.0",
    "express": "^4.22.1",
    "https-proxy-agent": "^7.0.6",
    "morgan": "^1.11.0",
    "mysql": "^2.18.1",
    "pg": "^8.16.0",
    "puppeteer": "^24.2.0",
    "rate-limiter-flexible": "^7.1.1",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.0.3",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/mysql": "^2.15.26",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "eslint": "^10.5.0",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-unicorn": "^61.0.2",
    "globals": "^16.5.0",
    "nodemon": "^3.1.9",
    "swagger-jsdoc": "^6.2.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
