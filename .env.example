#                                                                                    #
# The .env file contains all the environment variables needed to run the project.    #
# Rename this file to .env and fill the values before starting the project.          #
#                                                                                    #
######################################################################################

# production or development. This will enable/disable some logging and debug features.
ENVIRONMENT=development
# Internal secret. This is used by the Backend API route to allow asset updates
INTERNAL_SECRET=put_your_internal_secret_here

########################################
# 1. Database section                  #
########################################

# Root password for MariaDB
SQL_ROOT_PASSWORD=put_your_root_password_here
# Database user password
SQL_PASSWORD=put_your_database_password_here
# Database user for MariaDB and Postgres (you can change it if needed)
SQL_USER=ggetracker
# Postgres host (you can use the service name `postgres`)
PG_HOST=postgres
# MariaDB host (you can use the service name `mariadb`)
MARIADB_HOST=mariadb
# ClickHouse host (you can use the service name `clickhouse`)
CLICKHOUSE_HOST=clickhouse
# ClickHouse user (default user is 'default')
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=put_your_clickhouse_password_here
# SELECT-only ClickHouse user for Grafana, created by monitoring/grafana/provisioning/scripts/create-clickhouse-reader.sh
# (Grafana falls back to CLICKHOUSE_USER while these are unset)
GRAFANA_CLICKHOUSE_USER=grafana_reader
GRAFANA_CLICKHOUSE_PASSWORD=put_a_password
# ClickHouse storage policy (default is 'default')
CLICKHOUSE_STORAGE=default
# Default database name created at startup. Please do not change it.
SQL_DATABASE="empire-ranking"
# Only read when CLICKHOUSE_STORAGE=s3 (hot and cold volumes on an S3 bucket)
CLICKHOUSE_S3_ENDPOINT=
CLICKHOUSE_S3_SECRET_KEY=
CLICKHOUSE_S3_ACCESS_KEY=

########################################
# 2. Monitoring section                #
########################################

# Grafana admin username
GF_USERNAME=put_your_grafana_username_here
# Grafana admin password
GF_PASSWORD=put_your_grafana_password_here
# Grafana log level (default is "info". Other options: "debug", "info", "warn", "error", "critical")
GF_LOG_LEVEL="warn"
# Public address of Grafana, used by the links in its Discord alerts (default http://localhost:3001)
GRAFANA_ROOT_URL=

GF_ADMIN_VIEWER_USER=put_your_admin_viewer_username_here
GF_ADMIN_VIEWER_PASSWORD=put_your_admin_viewer_password_here
GF_ADMIN_VIEWER_EMAIL=
GF_MOD_VIEWER_USER=put_your_mod_viewer_username_here
GF_MOD_VIEWER_PASSWORD=put_your_mod_viewer_password_here
GF_MOD_VIEWER_EMAIL=
GF_PARTNER_VIEWER_USER=put_your_partner_viewer_username_here
GF_PARTNER_VIEWER_PASSWORD=put_your_partner_viewer_password_here
GF_PARTNER_VIEWER_EMAIL=

########################################
# 3. Application section               #
########################################

# The two game bridges
GGE_API_PORT=3000
GGE_API_URL_REALTIME=http://empire-api-realtime
GGE_API_PORT_REALTIME=3000
# Discord status of the bridge sockets, posted by both empire-api instances (optional, off when empty)
# Either the bot's send-message endpoint and a channel, or a plain webhook
STATUS_DISCORD_API_URL=
STATUS_DISCORD_CHANNEL_ID=
STATUS_DISCORD_WEBHOOK_URL=
# How often a server still offline is reminded, in ms (default 6h, 0 disables)
STATUS_REMINDER_MS=
# Discord webhook url used by the scraping service (optional)
WEBHOOK_URL=put_your_webhook_url_here
# Discord webhook url used by Grafana alerting
DISCORD_WEBHOOK_URL=put_your_discord_webhook_url_here
# Discord webhook url used by the weekly recap
DISCORD_MONITORING_WEBHOOK_URL=put_your_discord_monitoring_webhook_url_here

########################################
# 3b. Grafana reporting section        #
########################################

GF_RENDERER_TOKEN=put_your_renderer_token_here
GF_RENDERER_LOG_LEVEL=warn
GF_RENDERER_GOMEMLIMIT=192MiB
GF_RENDERER_READINESS_TIMEOUT=120s
RECAP_WEBHOOK_URL=
RECAP_SCHEDULE=0 9 * * 1
RECAP_TZ=UTC
RECAP_WINDOW_DAYS=7
RECAP_RENDER_TZ=UTC
RECAP_THEME=dark
RECAP_IMAGE_SCALE=2
RECAP_RENDER_TIMEOUT=180
RECAP_USERNAME=gge-tracker
RECAP_EMBED_COLOR=3447003
RECAP_CF_ZONE=
RECAP_RUN_ON_START=0

########################################
# 4. Cloudflare section                #
########################################

CF_API_TOKEN=put_your_cloudflare_api_token_here
# Zone id, shown on the Cloudflare dashboard overview page for the domain
CF_ZONE_ID=put_your_cloudflare_zone_id_here
# Account id, the hex string in the dashboard URL after dash.cloudflare.com/
CF_ACCOUNT_ID=put_your_cloudflare_account_id_here
# Seconds between calls to the Cloudflare API by cloudflare-zone-exporter
CF_SCRAPE_INTERVAL=300
# How far back the lablabs exporter looks, to stay behind Cloudflare's lag
CF_SCRAPE_DELAY=300
# Log level for the lablabs exporter (error, warn, info, debug)
CF_LOG_LEVEL=error

########################################
# 5. Store egress section              #
########################################

STORE_EGRESS_HOST=
STORE_EGRESS_PORT=
STORE_EGRESS_USER=
STORE_EGRESS_PASSWORD=

########################################
# 6. Bridge answer budget section      #
########################################

# Per-server floor
#RESPONSE_TIMEOUT_BASE_MS=800
#RESPONSE_TIMEOUT_ROUND_TRIPS=8
#RESPONSE_TIMEOUT_MIN_MS=1000
#RESPONSE_TIMEOUT_MAX_MS=3000

# Per-command headroom
#RESPONSE_TIMEOUT_HEADROOM=3
#RESPONSE_TIMEOUT_SAMPLES=100

# Debugging only
#RESPONSE_TIMEOUT_MS=0

# Public website origin used in link previews (canonical and og:url). Defaults to https://gge-tracker.com
SITE_URL=
# Public origin of this backend, used in preview image URLs (https://api.gge-tracker.com when empty)
BACKEND_API_URI=http://localhost:3000

# Bearer token of the /admin/api-keys routes (partner key management). At least 32 characters; empty answers 404
ADMIN_API_TOKEN=

########################################
# 7. Backend guard section             #
########################################

# Anonymous rate limit: points per window, in seconds (defaults 30 and 5)
RATE_LIMIT_POINTS=
RATE_LIMIT_DURATION=
# Abuse detection: requests per IP and window before a client is flagged (defaults 10 and 60000)
IP_THRESHOLD=
IP_WINDOW_MS=
# How fast an abuse score decays (defaults 10000 ms and 0.5)
DECAY_INTERVAL_MS=
DECAY_FACTOR=
# Request log batches sent to Loki (defaults 1000 entries, 524288 bytes, 5000 ms, 5 retries from 500 ms)
LOG_MAX_ENTRIES=
LOG_MAX_BYTES=
LOG_FLUSH_INTERVAL_MS=
LOKI_MAX_RETRIES=
LOKI_RETRY_BASE_MS=
