    "mysql": "^2.18.1",
    "mysql2": "^3.14.1",
    "p-limit": "^6.2.0",
    "pg": "^8.16.0",
    "pino": "^9.14.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/mysql": "^2.15.26",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.2",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "eslint": "^10.9.1",
    "eslint-plugin-prettier": "^5.5.3",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
