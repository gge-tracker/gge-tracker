  "engines": {
    "node": ">=24"
  },
  "private": true,
  "description": "",
  "scripts": {
    "build": "tsc",
    "lint": "eslint -f json src tests",
    "lint-fix": "eslint --fix -f json src tests",
    "test": "TZ=UTC TS_NODE_PROJECT=tests/tsconfig.json TS_NODE_TRANSPILE_ONLY=true node --require ts-node/register tests/run.ts",
    "test:types": "tsc -p tests/tsconfig.json",
