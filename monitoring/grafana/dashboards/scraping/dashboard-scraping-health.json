          "queryType": "table",
          "rawSql": "SELECT\n  server AS `Server`,\n  dateDiff('minute', max(timestamp), now()) AS `Minutes since last fill`,\n  max(timestamp) AS `Last fill`,\n  argMax(durationMs, timestamp) AS `Last duration`,\n  count() AS `Fills`,\n  sum(criticalErrors) AS `Critical errors`,\n  argMax(playerCount, timestamp) AS `Players`,\n  argMax(allianceCount, timestamp) AS `Alliances`,\n  sum(playersCreated) AS `Players created`\nFROM logs.scrapes\nWHERE timestamp > now() - INTERVAL 7 DAY AND match(server, '^(${server:regex})$')\nGROUP BY `Server`\nORDER BY `Minutes since last fill` DESC",
