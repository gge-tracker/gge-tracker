          "rawSql": "SELECT countIf(age > 7200) AS value FROM (\n  SELECT server, dateDiff('second', max(timestamp), now()) AS age\n  FROM logs.scrapes\n  WHERE timestamp > now() - INTERVAL 7 DAY AND match(server, '^(${server:regex})$')\n  GROUP BY server\n)",
