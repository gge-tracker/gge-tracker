          "rawSql": "SELECT replaceRegexpOne(_db, '^(empire_ranking_|ggetracker_)', '') AS server, read_at AS `Read at`, player_id AS `Player`, before AS `Before`, after AS `After`, gain AS `Gain in one reading`\nFROM (\n  SELECT _database AS _db, created_at AS read_at, player_id, point AS after,\n    lagInFrame(point) OVER w AS before, after - before AS gain, lagInFrame(created_at) OVER w AS before_at\n  FROM merge(REGEXP('^(empire_ranking|ggetracker_)'), '^player_loot_history$')\n  WHERE created_at >= $__fromTime - INTERVAL 2 HOUR AND created_at <= $__toTime\n  WINDOW w AS (PARTITION BY _database, player_id ORDER BY created_at ROWS BETWEEN 1 PRECEDING AND CURRENT ROW))\nWHERE before_at >= $__fromTime AND dateDiff('minute', before_at, read_at) BETWEEN 1 AND 70\nORDER BY gain DESC LIMIT 50",
