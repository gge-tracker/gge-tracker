          "rawSql": "SELECT\n    toStartOfInterval(slice, INTERVAL 60 SECOND) AS t,\n    count() AS fills\nFROM (\n    SELECT arrayJoin(\n        arrayMap(\n            step -> toDateTime(toStartOfInterval(startTime, INTERVAL 60 SECOND) + (step * 60)),\n            range(0, toUInt32(dateDiff('second', startTime, timestamp) / 60) + 1)\n        )\n    ) AS slice\n    FROM logs.scrapes\n    WHERE timestamp >= $__fromTime AND startTime <= $__toTime AND match(server, '^(${server:regex})$')\n)\nGROUP BY t ORDER BY t",
          "refId": "A"
        }
      ],
